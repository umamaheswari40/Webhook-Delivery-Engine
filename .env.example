# Change this before a real deployment.
WEBHOOK_SECRET=change-this-to-a-long-random-secret

# Optional. SQLite is the default.
DATABASE_URL=sqlite:///./webhook_engine.db

# Optional. The assessment retry schedule itself is fixed in app/config.py.
WORKER_POLL_INTERVAL_SECONDS=0.5

# HTTP timeout for customer webhook endpoints.
HTTP_TIMEOUT_SECONDS=10
